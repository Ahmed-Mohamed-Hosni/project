@model IEnumerable<InventoryManagementSystem.Models.Sale>

@{
    ViewData["Title"] = "Sales History";
}

<div class="content-header">
    <div class="page-title-area">
        <h1>Sales & Invoices</h1>
        <p>Review customer receipts, order dates, and total revenues</p>
    </div>
    <div class="header-actions">
        <a asp-action="Create" class="btn-premium">
            <i class="bi bi-cart-plus"></i> Open POS Terminal
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0 rounded-4 shadow-sm mb-4" role="alert" style="background-color: rgba(16, 185, 129, 0.1); color: var(--success);">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show border-0 rounded-4 shadow-sm mb-4" role="alert" style="background-color: rgba(239, 68, 68, 0.1); color: var(--danger);">
        <i class="bi bi-x-circle-fill me-2"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="premium-panel animate-fade-in">
    <div class="panel-header">
        <div class="panel-title">
            <i class="bi bi-receipt"></i> Billing Invoices (@Model.Count())
        </div>
        <div class="panel-actions" style="width: 300px;">
            <form asp-action="Index" method="get">
                <div class="search-wrapper-premium">
                    <i class="bi bi-search"></i>
                    <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" class="form-input-premium" placeholder="Search by Invoice or Customer..." />
                </div>
            </form>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table-premium">
            <thead>
                <tr>
                    <th>Invoice No.</th>
                    <th>Date</th>
                    <th>Customer Name</th>
                    <th>Customer Phone</th>
                    <th style="text-align: right;">Total Bill</th>
                    <th>Cashier</th>
                    <th style="text-align: right; padding-right: 40px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="bi bi-receipt-cutoff" style="font-size: 2.5rem; display: block; margin-bottom: 12px;"></i>
                            No sales records found.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><strong style="color: var(--primary);">@item.InvoiceNumber</strong></td>
                            <td style="font-size: 0.9rem; color: var(--text-secondary);">@item.SaleDate.ToString("yyyy-MM-dd HH:mm")</td>
                            <td style="font-weight: 600;">@item.CustomerName</td>
                            <td class="text-secondary">@(string.IsNullOrEmpty(item.CustomerPhone) ? "-" : item.CustomerPhone)</td>
                            <td style="text-align: right; font-weight: 700; color: var(--text-main); font-size: 1.05rem;">
                                $@item.TotalAmount.ToString("F2")
                            </td>
                            <td>
                                <span class="badge-premium secondary px-3 py-1">
                                    <i class="bi bi-person-badge me-1"></i> @item.SalesPerson
                                </span>
                            </td>
                            <td style="text-align: right; padding-right: 20px;">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn-premium-secondary py-1 px-3 me-2" style="font-size: 0.8rem;">
                                    <i class="bi bi-eye text-primary"></i> Invoice
                                </a>
                                <form asp-action="Cancel" asp-route-id="@item.Id" method="post" style="display:inline;" onsubmit="return confirm('Cancelling this invoice will delete the record and return all items to stock. Proceed?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn-premium-danger py-1 px-3" style="font-size: 0.8rem;">
                                        <i class="bi bi-x-circle"></i> Cancel
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
