@model InventoryManagementSystem.Models.Category

@{
    ViewData["Title"] = "Edit Category";
}

<div class="content-header">
    <div class="page-title-area">
        <h1>Edit Category</h1>
        <p>Update category details and classification settings</p>
    </div>
    <div class="header-actions">
        <a asp-action="Index" class="btn-premium-secondary">
            <i class="bi bi-arrow-left"></i> Back to List
        </a>
    </div>
</div>

<div class="row animate-fade-in" style="max-width: 600px; margin: 0 auto;">
    <div class="col-md-12">
        <div class="premium-panel">
            <div class="panel-header">
                <div class="panel-title">
                    <i class="bi bi-pencil-fill"></i> Modify Category
                </div>
            </div>

            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="Id" />

                <div class="form-group-premium">
                    <label asp-for="Name" class="form-label-premium"></label>
                    <input asp-for="Name" class="form-input-premium" />
                    <span asp-validation-for="Name" class="text-danger" style="font-size: 0.8rem;"></span>
                </div>

                <div class="form-group-premium">
                    <label asp-for="Description" class="form-label-premium"></label>
                    <textarea asp-for="Description" rows="4" class="form-input-premium"></textarea>
                    <span asp-validation-for="Description" class="text-danger" style="font-size: 0.8rem;"></span>
                </div>

                <div class="mt-4 d-flex gap-2">
                    <button type="submit" class="btn-premium">
                        <i class="bi bi-save"></i> Save Changes
                    </button>
                    <a asp-action="Index" class="btn-premium-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
