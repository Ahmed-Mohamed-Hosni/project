@model IEnumerable<InventoryManagementSystem.Models.Supplier>

@{
    ViewData["Title"] = "Suppliers";
}

<div class="content-header">
    <div class="page-title-area">
        <h1>Suppliers Directory</h1>
        <p>Manage contact info, locations, and supply channels of products</p>
    </div>
    <div class="header-actions">
        <a asp-action="Create" class="btn-premium">
            <i class="bi bi-plus-lg"></i> Register Supplier
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0 rounded-4 shadow-sm mb-4" role="alert" style="background-color: rgba(16, 185, 129, 0.1); color: var(--success);">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="premium-panel animate-fade-in">
    <div class="panel-header">
        <div class="panel-title">
            <i class="bi bi-truck"></i> Registered Suppliers (@Model.Count())
        </div>
        <div class="panel-actions" style="width: 300px;">
            <form asp-action="Index" method="get">
                <div class="search-wrapper-premium">
                    <i class="bi bi-search"></i>
                    <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" class="form-input-premium" placeholder="Search suppliers..." />
                </div>
            </form>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table-premium">
            <thead>
                <tr>
                    <th>Supplier Name</th>
                    <th>Contact Person</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Address</th>
                    <th style="text-align: right; padding-right: 40px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            <i class="bi bi-building-slash" style="font-size: 2.5rem; display: block; margin-bottom: 12px;"></i>
                            No suppliers found. Click "Register Supplier" to add one.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td style="font-weight: 600;">@item.Name</td>
                            <td>@(string.IsNullOrEmpty(item.ContactName) ? "-" : item.ContactName)</td>
                            <td>
                                @if (string.IsNullOrEmpty(item.Email))
                                {
                                    <span>-</span>
                                }
                                else
                                {
                                    <a href="mailto:@item.Email" class="text-primary"><i class="bi bi-envelope-at me-1"></i> @item.Email</a>
                                }
                            </td>
                            <td>@(string.IsNullOrEmpty(item.Phone) ? "-" : item.Phone)</td>
                            <td class="text-secondary" style="max-width: 250px; text-overflow: ellipsis; overflow: hidden; white-space: nowrap;">
                                @(string.IsNullOrEmpty(item.Address) ? "-" : item.Address)
                            </td>
                            <td style="text-align: right; padding-right: 20px;">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn-premium-secondary py-1 px-3 me-2" style="font-size: 0.8rem;">
                                    <i class="bi bi-pencil-square text-primary"></i> Edit
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn-premium-danger py-1 px-3" style="font-size: 0.8rem;">
                                    <i class="bi bi-trash3-fill"></i> Delete
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
