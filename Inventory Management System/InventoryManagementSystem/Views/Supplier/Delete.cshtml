@model InventoryManagementSystem.Models.Supplier

@{
    ViewData["Title"] = "Delete Supplier";
}

<div class="content-header">
    <div class="page-title-area">
        <h1>Delete Supplier</h1>
        <p>Permanently remove supplier records from the system</p>
    </div>
    <div class="header-actions">
        <a asp-action="Index" class="btn-premium-secondary">
            <i class="bi bi-arrow-left"></i> Back to Directory
        </a>
    </div>
</div>

<div class="row animate-fade-in" style="max-width: 600px; margin: 0 auto;">
    <div class="col-md-12">
        <div class="premium-panel">
            <div class="panel-header">
                <div class="panel-title text-danger">
                    <i class="bi bi-exclamation-triangle-fill"></i> Are you sure you want to delete this?
                </div>
            </div>

            <!-- Error alerts from controller model state -->
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger border-0 rounded-4 shadow-sm mb-4" role="alert" style="background-color: rgba(239, 68, 68, 0.1); color: var(--danger);">
                    <div asp-validation-summary="All" class="text-danger list-unstyled"></div>
                </div>
            }

            <div class="mb-4">
                <h5 class="text-secondary" style="font-size: 0.95rem; font-weight: 600; margin-bottom: 4px;">Supplier Name</h5>
                <p style="font-size: 1.15rem; font-weight: 700;">@Model.Name</p>
            </div>

            <div class="row mb-4">
                <div class="col-md-6">
                    <h5 class="text-secondary" style="font-size: 0.85rem; font-weight: 600; margin-bottom: 4px;">Contact Person</h5>
                    <p style="font-size: 0.95rem; font-weight: 500;">@(string.IsNullOrEmpty(Model.ContactName) ? "-" : Model.ContactName)</p>
                </div>
                <div class="col-md-6">
                    <h5 class="text-secondary" style="font-size: 0.85rem; font-weight: 600; margin-bottom: 4px;">Phone</h5>
                    <p style="font-size: 0.95rem; font-weight: 500;">@(string.IsNullOrEmpty(Model.Phone) ? "-" : Model.Phone)</p>
                </div>
            </div>

            <div class="mb-4">
                <h5 class="text-secondary" style="font-size: 0.85rem; font-weight: 600; margin-bottom: 4px;">Email</h5>
                <p style="font-size: 0.95rem; font-weight: 500;">@(string.IsNullOrEmpty(Model.Email) ? "-" : Model.Email)</p>
            </div>

            <div class="mb-4">
                <h5 class="text-secondary" style="font-size: 0.85rem; font-weight: 600; margin-bottom: 4px;">Address</h5>
                <p style="font-size: 0.95rem; color: var(--text-secondary);">@(string.IsNullOrEmpty(Model.Address) ? "-" : Model.Address)</p>
            </div>

            <form asp-action="Delete">
                <input type="hidden" asp-for="Id" />
                <div class="d-flex gap-2">
                    <button type="submit" class="btn-premium-danger">
                        <i class="bi bi-trash3-fill"></i> Confirm Delete
                    </button>
                    <a asp-action="Index" class="btn-premium-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
