@model InventoryManagementSystem.Models.Product

@{
    ViewData["Title"] = "Adjust Stock";
}

<div class="content-header">
    <div class="page-title-area">
        <h1>Adjust Inventory Stock</h1>
        <p>Manually increment or decrement stock levels for audit reconciliation</p>
    </div>
    <div class="header-actions">
        <a asp-action="Index" class="btn-premium-secondary">
            <i class="bi bi-arrow-left"></i> Back to Catalog
        </a>
    </div>
</div>

<div class="row animate-fade-in" style="max-width: 650px; margin: 0 auto;">
    <div class="col-md-12">
        <div class="premium-panel mb-4">
            <div class="panel-header">
                <div class="panel-title">
                    <i class="bi bi-box-seam-fill"></i> Product Information
                </div>
            </div>
            
            <div class="row">
                <div class="col-md-6 mb-3">
                    <span class="text-secondary d-block" style="font-size: 0.8rem; font-weight: 600;">Product Name</span>
                    <strong style="font-size: 1.05rem;">@Model.Name</strong>
                </div>
                <div class="col-md-6 mb-3">
                    <span class="text-secondary d-block" style="font-size: 0.8rem; font-weight: 600;">SKU</span>
                    <code>@Model.SKU</code>
                </div>
                <div class="col-md-6">
                    <span class="text-secondary d-block" style="font-size: 0.8rem; font-weight: 600;">Category</span>
                    <span class="badge-premium secondary mt-1">@Model.Category?.Name</span>
                </div>
                <div class="col-md-6">
                    <span class="text-secondary d-block" style="font-size: 0.8rem; font-weight: 600;">Current Stock Level</span>
                    @if (Model.StockQuantity <= Model.ReorderLevel)
                    {
                        <span class="badge-premium danger mt-1"><i class="bi bi-exclamation-triangle-fill"></i> @Model.StockQuantity Alert</span>
                    }
                    else
                    {
                        <span class="badge-premium success mt-1">@Model.StockQuantity Units</span>
                    }
                </div>
            </div>
        </div>

        <div class="premium-panel">
            <div class="panel-header">
                <div class="panel-title">
                    <i class="bi bi-arrow-down-up"></i> Register Stock Adjustment
                </div>
            </div>

            <form asp-action="AdjustStock">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="Id" />

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group-premium">
                            <label class="form-label-premium">Adjustment Type</label>
                            <select name="adjustmentType" class="form-input-premium" required>
                                <option value="Stock In">Stock In (+) - Purchase / Restock</option>
                                <option value="Stock Out">Stock Out (-) - Damaged / Stolen / Internal Use</option>
                                <option value="Adjustment">Adjustment (+/-) - Count Discrepancy</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group-premium">
                            <label class="form-label-premium">Quantity Change</label>
                            <input name="adjustmentQuantity" type="number" min="1" class="form-input-premium" placeholder="e.g. 5" required />
                            <small class="text-muted">Enter positive number only. The type selects addition or subtraction.</small>
                        </div>
                    </div>
                </div>

                <div class="form-group-premium">
                    <label class="form-label-premium">Adjustment Reason / Notes</label>
                    <textarea name="description" rows="3" class="form-input-premium" placeholder="Write reason (e.g. Periodic stock count, water damage, supplier replacement)..." required></textarea>
                </div>

                <div class="mt-4 d-flex gap-2">
                    <button type="submit" class="btn-premium">
                        <i class="bi bi-check-lg"></i> Apply Adjustment
                    </button>
                    <a asp-action="Index" class="btn-premium-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
