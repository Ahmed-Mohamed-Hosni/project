<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Inventory Management System</title>
    
    <!-- Bootstrap CSS (Local) -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    
    <!-- Bootstrap Icons via CDN -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    
    <!-- Custom site.css -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    
    <!-- ASP.NET Styles (compiled) -->
    <link rel="stylesheet" href="~/InventoryManagementSystem.styles.css" asp-append-version="true" />
</head>
<body>

    <div class="app-container">
        <!-- Sidebar Navigation -->
        <aside class="app-sidebar">
            <div class="sidebar-header">
                <div class="sidebar-logo-icon">
                    <i class="bi bi-box-seam-fill"></i>
                </div>
                <div class="sidebar-logo-text">IMS Pro</div>
            </div>
            
            <ul class="sidebar-menu">
                <li class="sidebar-menu-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")">
                    <a asp-controller="Home" asp-action="Index" class="sidebar-link">
                        <i class="bi bi-grid-1x2-fill"></i>
                        <span>Dashboard</span>
                    </a>
                </li>
                <li class="sidebar-menu-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Product" ? "active" : "")">
                    <a asp-controller="Product" asp-action="Index" class="sidebar-link">
                        <i class="bi bi-tags-fill"></i>
                        <span>Products</span>
                    </a>
                </li>
                <li class="sidebar-menu-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Category" ? "active" : "")">
                    <a asp-controller="Category" asp-action="Index" class="sidebar-link">
                        <i class="bi bi-folder-fill"></i>
                        <span>Categories</span>
                    </a>
                </li>
                <li class="sidebar-menu-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Supplier" ? "active" : "")">
                    <a asp-controller="Supplier" asp-action="Index" class="sidebar-link">
                        <i class="bi bi-truck-flatbed"></i>
                        <span>Suppliers</span>
                    </a>
                </li>
                <li class="sidebar-menu-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Sale" && ViewContext.RouteData.Values["action"]?.ToString() == "Create" ? "active" : "")">
                    <a asp-controller="Sale" asp-action="Create" class="sidebar-link">
                        <i class="bi bi-cart-fill"></i>
                        <span>New Sale (POS)</span>
                    </a>
                </li>
                <li class="sidebar-menu-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Sale" && ViewContext.RouteData.Values["action"]?.ToString() != "Create" ? "active" : "")">
                    <a asp-controller="Sale" asp-action="Index" class="sidebar-link">
                        <i class="bi bi-receipt-cutoff"></i>
                        <span>Sales History</span>
                    </a>
                </li>
                <li class="sidebar-menu-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "StockTransaction" ? "active" : "")">
                    <a asp-controller="StockTransaction" asp-action="Index" class="sidebar-link">
                        <i class="bi bi-journal-text"></i>
                        <span>Stock Logs</span>
                    </a>
                </li>
            </ul>
            
            <!-- Developer Branding Footer -->
            <div class="sidebar-footer">
                <div class="developer-badge">
                    <div class="developer-title">Developed By</div>
                    <div class="developer-name">Ahmed Mohamed Hosni</div>
                    <div class="developer-name-ar">أحمد محمد حسني</div>
                </div>
            </div>
        </aside>

        <!-- Main Content Area -->
        <main class="app-content">
            @RenderBody()
        </main>
    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    
    <!-- Chart.js CDN (Loaded globally for charts) -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
