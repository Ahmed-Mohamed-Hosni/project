@model IEnumerable<E_Commerce.Models.Order>
@{
    ViewData["Title"] = "Orders";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h5 style="font-weight:700;margin:0;">All Orders</h5>
        <p style="color:#636e72;font-size:0.85rem;margin:0;">Track and manage customer orders</p>
    </div>
    <div class="d-flex gap-2">
        <a href="@Url.Action("Index")" class="btn btn-sm @(ViewBag.CurrentStatus == null ? "btn-admin-primary" : "btn-outline-secondary")">All</a>
        <a href="@Url.Action("Index", new { status = "Pending" })" class="btn btn-sm @(ViewBag.CurrentStatus == "Pending" ? "btn-admin-primary" : "btn-outline-secondary")">Pending</a>
        <a href="@Url.Action("Index", new { status = "Processing" })" class="btn btn-sm @(ViewBag.CurrentStatus == "Processing" ? "btn-admin-primary" : "btn-outline-secondary")">Processing</a>
        <a href="@Url.Action("Index", new { status = "Shipped" })" class="btn btn-sm @(ViewBag.CurrentStatus == "Shipped" ? "btn-admin-primary" : "btn-outline-secondary")">Shipped</a>
        <a href="@Url.Action("Index", new { status = "Delivered" })" class="btn btn-sm @(ViewBag.CurrentStatus == "Delivered" ? "btn-admin-primary" : "btn-outline-secondary")">Delivered</a>
    </div>
</div>

<div class="admin-table">
    <table class="table">
        <thead>
            <tr>
                <th>Order #</th>
                <th>Customer</th>
                <th>Date</th>
                <th>Total</th>
                <th>Status</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in Model)
            {
                var badgeClass = order.OrderStatus switch
                {
                    "Pending" => "badge-pending",
                    "Processing" => "badge-processing",
                    "Shipped" => "badge-shipped",
                    "Delivered" => "badge-delivered",
                    "Cancelled" => "badge-cancelled",
                    _ => "badge-pending"
                };
                <tr>
                    <td><strong>#@order.Id</strong></td>
                    <td>@order.User?.FullName</td>
                    <td>@order.OrderDate.ToString("MMM dd, yyyy HH:mm")</td>
                    <td><strong style="color:#6C63FF;">$@order.OrderTotal.ToString("N2")</strong></td>
                    <td><span class="badge-status @badgeClass">@order.OrderStatus</span></td>
                    <td><a href="@Url.Action("Details", new { id = order.Id })" class="btn btn-sm btn-outline-primary"><i class="fas fa-eye"></i> Details</a></td>
                </tr>
            }
        </tbody>
    </table>
    @if (!Model.Any())
    {
        <div style="text-align:center;padding:40px;color:#636e72;">
            <i class="fas fa-inbox" style="font-size:2rem;margin-bottom:10px;display:block;"></i>
            <p>No orders found</p>
        </div>
    }
</div>
