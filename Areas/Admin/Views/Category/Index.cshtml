@model IEnumerable<Category>
@{
    ViewData["Title"] = "Categories";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h5 style="font-weight:700;margin:0;">All Categories</h5>
        <p style="color:#636e72;font-size:0.85rem;margin:0;">Manage your product categories</p>
    </div>
    <a href="@Url.Action("Create")" class="btn btn-admin-primary"><i class="fas fa-plus"></i> Add Category</a>
</div>

<div class="admin-table">
    <table class="table">
        <thead>
            <tr>
                <th>#</th>
                <th>Name</th>
                <th>Description</th>
                <th>Products</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var cat in Model)
            {
                <tr>
                    <td>@cat.Id</td>
                    <td><strong>@cat.Name</strong></td>
                    <td style="color:#636e72;">@(cat.Description ?? "—")</td>
                    <td><span class="badge bg-primary rounded-pill">@cat.Products.Count</span></td>
                    <td>
                        <a href="@Url.Action("Edit", new { id = cat.Id })" class="btn btn-sm btn-outline-primary"><i class="fas fa-edit"></i></a>
                        <a href="@Url.Action("Delete", new { id = cat.Id })" class="btn btn-sm btn-outline-danger"><i class="fas fa-trash"></i></a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    @if (!Model.Any())
    {
        <div style="text-align:center;padding:40px;color:#636e72;">
            <i class="fas fa-tags" style="font-size:2rem;margin-bottom:10px;display:block;"></i>
            <p>No categories yet. Create your first one!</p>
        </div>
    }
</div>
