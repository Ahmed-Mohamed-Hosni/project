@model Category
@{
    ViewData["Title"] = "Delete Category";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="admin-form-card text-center">
            <div style="width:70px;height:70px;background:rgba(255,101,132,0.12);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 20px;font-size:1.8rem;color:#FF6584;">
                <i class="fas fa-exclamation-triangle"></i>
            </div>
            <h5 style="font-weight:700;margin-bottom:8px;">Delete Category</h5>
            <p style="color:#636e72;margin-bottom:24px;">Are you sure you want to delete <strong>"@Model.Name"</strong>? This will also affect <strong>@Model.Products.Count product(s)</strong>.</p>
            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="Id" />
                <div class="d-flex gap-2 justify-content-center">
                    <button type="submit" class="btn btn-admin-danger"><i class="fas fa-trash"></i> Yes, Delete</button>
                    <a href="@Url.Action("Index")" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
