@model IEnumerable<Appointment>
@{
    ViewData["Title"] = "Admin Dashboard";
    var currentFilter = ViewBag.CurrentFilter as string ?? "";
}

<div class="row">
    <!-- Admin Sidebar Navigation -->
    <div class="col-lg-3 mb-4">
        <div class="glass-panel p-3">
            <h5 class="text-white mb-3 pb-2" style="border-bottom: 1px solid var(--border-color);">
                <i class="bi bi-shield-lock text-primary me-2"></i> Control Room
            </h5>
            <div class="list-group list-group-flush bg-transparent">
                <a asp-action="Dashboard" class="list-group-item bg-transparent text-white border-0 px-0 py-2 fw-semibold">
                    <i class="bi bi-speedometer2 text-primary me-2"></i> Bookings Dashboard
                </a>
                <a asp-action="Services" class="list-group-item bg-transparent text-secondary border-0 px-0 py-2 nav-link-custom">
                    <i class="bi bi-list-task text-secondary me-2"></i> Manage Services
                </a>
                <a asp-action="Providers" class="list-group-item bg-transparent text-secondary border-0 px-0 py-2 nav-link-custom">
                    <i class="bi bi-people text-secondary me-2"></i> Manage Specialists
                </a>
                <a asp-controller="Home" asp-action="Index" class="list-group-item bg-transparent text-secondary border-0 px-0 py-2 nav-link-custom">
                    <i class="bi bi-arrow-left text-secondary me-2"></i> Public Homepage
                </a>
            </div>
            
            <hr class="my-3" style="border-color: var(--border-color);" />
            
            <div class="text-center py-2" style="background: rgba(255,255,255,0.01); border-radius: 8px;">
                <span class="text-muted small d-block">Admin Engine Author</span>
                <span class="text-white small fw-bold">Ahmed Mohamed Hosni</span>
            </div>
        </div>
    </div>

    <!-- Main Content Area -->
    <div class="col-lg-9">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="h3 text-white mb-0">Bookings Control Board</h1>
            <span class="badge-custom badge-custom-primary"><i class="bi bi-clock-history"></i> Live Feed</span>
        </div>

        @if (TempData["AdminSuccessMessage"] != null)
        {
            <div class="alert alert-success bg-success bg-opacity-10 border-success text-success rounded-3 mb-4 animate-fade-in" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i> @TempData["AdminSuccessMessage"]
            </div>
        }
        @if (TempData["AdminErrorMessage"] != null)
        {
            <div class="alert alert-danger bg-danger bg-opacity-10 border-danger text-danger rounded-3 mb-4 animate-fade-in" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["AdminErrorMessage"]
            </div>
        }

        <!-- Stats Cards -->
        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <div class="glass-card p-3 d-flex align-items-center gap-3">
                    <div class="stats-icon bg-primary bg-opacity-15 rounded text-primary p-2 mb-0">
                        <i class="bi bi-calendar-check fs-4"></i>
                    </div>
                    <div>
                        <span class="text-muted small d-block">Total Bookings</span>
                        <h3 class="h4 text-white fw-bold mb-0">@ViewBag.Total</h3>
                    </div>
                </div>
            </div>
            
            <div class="col-md-3">
                <div class="glass-card p-3 d-flex align-items-center gap-3">
                    <div class="stats-icon bg-warning bg-opacity-15 rounded text-warning p-2 mb-0">
                        <i class="bi bi-hourglass-split fs-4"></i>
                    </div>
                    <div>
                        <span class="text-muted small d-block">Pending</span>
                        <h3 class="h4 text-white fw-bold mb-0">@ViewBag.Pending</h3>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="glass-card p-3 d-flex align-items-center gap-3">
                    <div class="stats-icon bg-success bg-opacity-15 rounded text-success p-2 mb-0">
                        <i class="bi bi-currency-dollar fs-4"></i>
                    </div>
                    <div>
                        <span class="text-muted small d-block">Revenue</span>
                        <h3 class="h4 text-white fw-bold mb-0">$@ViewBag.Revenue.ToString("0")</h3>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="glass-card p-3 d-flex align-items-center gap-3">
                    <div class="stats-icon bg-info bg-opacity-15 rounded text-info p-2 mb-0">
                        <i class="bi bi-check2-all fs-4"></i>
                    </div>
                    <div>
                        <span class="text-muted small d-block">Completed</span>
                        <h3 class="h4 text-white fw-bold mb-0">@ViewBag.Completed</h3>
                    </div>
                </div>
            </div>
        </div>

        <!-- Filter controls -->
        <div class="glass-panel p-3 mb-4">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                <h4 class="h6 text-white mb-0"><i class="bi bi-funnel me-1"></i> Filter Bookings</h4>
                <div class="d-flex flex-wrap gap-2">
                    <a asp-action="Dashboard" asp-route-statusFilter="" class="btn btn-sm btn-custom @(string.IsNullOrEmpty(currentFilter) ? "btn-custom-primary" : "btn-custom-secondary") py-1">
                        All
                    </a>
                    <a asp-action="Dashboard" asp-route-statusFilter="Pending" class="btn btn-sm btn-custom @(currentFilter == "Pending" ? "btn-custom-primary" : "btn-custom-secondary") py-1">
                        Pending
                    </a>
                    <a asp-action="Dashboard" asp-route-statusFilter="Confirmed" class="btn btn-sm btn-custom @(currentFilter == "Confirmed" ? "btn-custom-primary" : "btn-custom-secondary") py-1">
                        Confirmed
                    </a>
                    <a asp-action="Dashboard" asp-route-statusFilter="Completed" class="btn btn-sm btn-custom @(currentFilter == "Completed" ? "btn-custom-primary" : "btn-custom-secondary") py-1">
                        Completed
                    </a>
                    <a asp-action="Dashboard" asp-route-statusFilter="Cancelled" class="btn btn-sm btn-custom @(currentFilter == "Cancelled" ? "btn-custom-primary" : "btn-custom-secondary") py-1">
                        Cancelled
                    </a>
                </div>
            </div>
        </div>

        <!-- Appointments Table -->
        <div class="glass-panel p-0 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-custom mb-0">
                    <thead>
                        <tr>
                            <th>Ref Code</th>
                            <th>Customer</th>
                            <th>Service / Provider</th>
                            <th>Schedule</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-5">
                                    <i class="bi bi-inbox display-6 mb-3"></i>
                                    <p class="small mb-0">No appointments found matching this status filter.</p>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var app in Model)
                            {
                                var statusBadgeClass = app.Status switch
                                {
                                    AppointmentStatus.Pending => "badge-custom-warning",
                                    AppointmentStatus.Confirmed => "badge-custom-primary",
                                    AppointmentStatus.Completed => "badge-custom-success",
                                    AppointmentStatus.Cancelled => "badge-custom-danger",
                                    _ => "badge-custom-primary"
                                };

                                <tr>
                                    <td class="fw-bold text-white small" style="font-family: monospace;">@app.BookingCode</td>
                                    <td>
                                        <div class="fw-semibold text-white small">@app.CustomerName</div>
                                        <div class="text-muted small" style="font-size:0.75rem;">@app.CustomerPhone</div>
                                    </td>
                                    <td>
                                        <div class="text-white small fw-bold">@app.Service?.Name</div>
                                        <div class="text-muted small" style="font-size:0.75rem;"><i class="bi bi-person me-1"></i> @app.Provider?.Name</div>
                                    </td>
                                    <td>
                                        <div class="text-white small fw-bold">@app.AppointmentDate.ToString("MMM dd, yyyy")</div>
                                        <div class="text-secondary small" style="font-size:0.75rem;"><i class="bi bi-clock me-1"></i> @DateTime.Today.Add(app.TimeSlot).ToString("hh:mm tt")</div>
                                    </td>
                                    <td>
                                        <span class="badge-custom @statusBadgeClass" style="font-size:0.75rem; padding: 0.2rem 0.5rem;">
                                            @app.Status
                                        </span>
                                    </td>
                                    <td>
                                        <div class="d-flex gap-1">
                                            @if (app.Status == AppointmentStatus.Pending)
                                            {
                                                <form asp-action="UpdateStatus" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@app.Id" />
                                                    <input type="hidden" name="status" value="Confirmed" />
                                                    <button type="submit" class="btn btn-sm btn-custom btn-custom-success py-1 px-2" title="Confirm Booking" style="font-size: 0.75rem;">
                                                        Confirm
                                                    </button>
                                                </form>
                                            }
                                            @if (app.Status == AppointmentStatus.Confirmed)
                                            {
                                                <form asp-action="UpdateStatus" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@app.Id" />
                                                    <input type="hidden" name="status" value="Completed" />
                                                    <button type="submit" class="btn btn-sm btn-custom btn-custom-success py-1 px-2" title="Mark as Completed" style="font-size: 0.75rem;">
                                                        Complete
                                                    </button>
                                                </form>
                                            }
                                            @if (app.Status != AppointmentStatus.Cancelled && app.Status != AppointmentStatus.Completed)
                                            {
                                                <form asp-action="UpdateStatus" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@app.Id" />
                                                    <input type="hidden" name="status" value="Cancelled" />
                                                    <button type="submit" class="btn btn-sm btn-custom btn-custom-danger py-1 px-2" title="Cancel Booking" style="font-size: 0.75rem;">
                                                        Cancel
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
