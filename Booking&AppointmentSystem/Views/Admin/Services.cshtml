@model IEnumerable<Service>
@{
    ViewData["Title"] = "Manage Services";
    var categories = ViewBag.Categories as List<Category> ?? new List<Category>();
}

<div class="row">
    <!-- Admin Navigation Sidebar -->
    <div class="col-lg-3 mb-4">
        <div class="glass-panel p-3">
            <h5 class="text-white mb-3 pb-2" style="border-bottom: 1px solid var(--border-color);">
                <i class="bi bi-shield-lock text-primary me-2"></i> Control Room
            </h5>
            <div class="list-group list-group-flush bg-transparent">
                <a asp-action="Dashboard" class="list-group-item bg-transparent text-secondary border-0 px-0 py-2 nav-link-custom">
                    <i class="bi bi-speedometer2 text-secondary me-2"></i> Bookings Dashboard
                </a>
                <a asp-action="Services" class="list-group-item bg-transparent text-white border-0 px-0 py-2 fw-semibold">
                    <i class="bi bi-list-task text-primary me-2"></i> Manage Services
                </a>
                <a asp-action="Providers" class="list-group-item bg-transparent text-secondary border-0 px-0 py-2 nav-link-custom">
                    <i class="bi bi-people text-secondary me-2"></i> Manage Specialists
                </a>
                <a asp-controller="Home" asp-action="Index" class="list-group-item bg-transparent text-secondary border-0 px-0 py-2 nav-link-custom">
                    <i class="bi bi-arrow-left text-secondary me-2"></i> Public Homepage
                </a>
            </div>
        </div>
    </div>

    <!-- Main Content Area -->
    <div class="col-lg-9">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="h3 text-white mb-0">System Services Portfolio</h1>
            <span class="badge-custom badge-custom-primary"><i class="bi bi-gear-fill"></i> Configurations</span>
        </div>

        @if (TempData["AdminSuccessMessage"] != null)
        {
            <div class="alert alert-success bg-success bg-opacity-10 border-success text-success rounded-3 mb-4 animate-fade-in" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i> @TempData["AdminSuccessMessage"]
            </div>
        }
        @if (TempData["AdminErrorMessage"] != null)
        {
            <div class="alert alert-danger bg-danger bg-opacity-10 border-danger text-danger rounded-3 mb-4 animate-fade-in" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["AdminErrorMessage"]
            </div>
        }

        <div class="row g-4">
            <!-- Services List Panel -->
            <div class="col-md-7">
                <div class="glass-panel p-0 overflow-hidden">
                    <div class="p-3 border-bottom" style="border-color: var(--border-color);">
                        <h5 class="text-white mb-0">All Available Services</h5>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-custom mb-0">
                            <thead>
                                <tr>
                                    <th>Service Name</th>
                                    <th>Price</th>
                                    <th>Duration</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var srv in Model)
                                {
                                    <tr>
                                        <td>
                                            <div class="text-white fw-bold small">@srv.Name</div>
                                            <div class="text-muted small" style="font-size:0.75rem;">@srv.Category?.Name</div>
                                        </td>
                                        <td class="text-white small fw-bold">$@srv.Price.ToString("0.00")</td>
                                        <td class="text-secondary small">@srv.DurationMinutes mins</td>
                                        <td>
                                            <form asp-action="DeleteService" method="post" onsubmit="return confirm('Are you sure you want to delete this service?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@srv.Id" />
                                                <button type="submit" class="btn btn-sm btn-custom btn-custom-danger py-1 px-2" style="font-size:0.75rem;" title="Delete Service">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Create New Service Card -->
            <div class="col-md-5">
                <div class="glass-panel">
                    <h5 class="text-white mb-4"><i class="bi bi-plus-circle-fill text-primary me-2"></i> Add New Service</h5>
                    
                    <form asp-action="AddService" method="post">
                        @Html.AntiForgeryToken()
                        
                        <div class="mb-3">
                            <label for="name" class="form-label text-white small">Service Name</label>
                            <input type="text" class="form-control form-control-custom" id="name" name="name" required placeholder="e.g. Skin Hydration Treatment" />
                        </div>
                        
                        <div class="mb-3">
                            <label for="categoryId" class="form-label text-white small">Category</label>
                            <select class="form-select form-control-custom" id="categoryId" name="categoryId" required>
                                <option value="">-- Choose Category --</option>
                                @foreach (var cat in categories)
                                {
                                    <option value="@cat.Id">@cat.Name</option>
                                }
                            </select>
                        </div>
                        
                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <label for="price" class="form-label text-white small">Price ($)</label>
                                <input type="number" step="0.01" class="form-control form-control-custom" id="price" name="price" required placeholder="50.00" min="0" />
                            </div>
                            <div class="col-6">
                                <label for="durationMinutes" class="form-label text-white small">Duration (mins)</label>
                                <input type="number" class="form-control form-control-custom" id="durationMinutes" name="durationMinutes" required placeholder="30" min="5" />
                            </div>
                        </div>

                        <div class="mb-4">
                            <label for="description" class="form-label text-white small">Description</label>
                            <textarea class="form-control form-control-custom" id="description" name="description" rows="3" placeholder="Brief details about what the service entails..."></textarea>
                        </div>

                        <button type="submit" class="btn btn-custom btn-custom-primary w-100 py-2">
                            <i class="bi bi-check-circle-fill me-1"></i> Register Service
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
