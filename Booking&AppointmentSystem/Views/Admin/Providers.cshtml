@model IEnumerable<Provider>
@{
    ViewData["Title"] = "Manage Specialists";
}

<div class="row">
    <!-- Admin Navigation Sidebar -->
    <div class="col-lg-3 mb-4">
        <div class="glass-panel p-3">
            <h5 class="text-white mb-3 pb-2" style="border-bottom: 1px solid var(--border-color);">
                <i class="bi bi-shield-lock text-primary me-2"></i> Control Room
            </h5>
            <div class="list-group list-group-flush bg-transparent">
                <a asp-action="Dashboard" class="list-group-item bg-transparent text-secondary border-0 px-0 py-2 nav-link-custom">
                    <i class="bi bi-speedometer2 text-secondary me-2"></i> Bookings Dashboard
                </a>
                <a asp-action="Services" class="list-group-item bg-transparent text-secondary border-0 px-0 py-2 nav-link-custom">
                    <i class="bi bi-list-task text-secondary me-2"></i> Manage Services
                </a>
                <a asp-action="Providers" class="list-group-item bg-transparent text-white border-0 px-0 py-2 fw-semibold">
                    <i class="bi bi-people text-primary me-2"></i> Manage Specialists
                </a>
                <a asp-controller="Home" asp-action="Index" class="list-group-item bg-transparent text-secondary border-0 px-0 py-2 nav-link-custom">
                    <i class="bi bi-arrow-left text-secondary me-2"></i> Public Homepage
                </a>
            </div>
        </div>
    </div>

    <!-- Main Content Area -->
    <div class="col-lg-9">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="h3 text-white mb-0">System Specialists Portfolio</h1>
            <span class="badge-custom badge-custom-primary"><i class="bi bi-people-fill"></i> Staffing</span>
        </div>

        @if (TempData["AdminSuccessMessage"] != null)
        {
            <div class="alert alert-success bg-success bg-opacity-10 border-success text-success rounded-3 mb-4 animate-fade-in" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i> @TempData["AdminSuccessMessage"]
            </div>
        }
        @if (TempData["AdminErrorMessage"] != null)
        {
            <div class="alert alert-danger bg-danger bg-opacity-10 border-danger text-danger rounded-3 mb-4 animate-fade-in" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["AdminErrorMessage"]
            </div>
        }

        <div class="row g-4">
            <!-- Providers List Panel -->
            <div class="col-md-7">
                <div class="glass-panel p-0 overflow-hidden">
                    <div class="p-3 border-bottom" style="border-color: var(--border-color);">
                        <h5 class="text-white mb-0">Registered Specialists</h5>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-custom mb-0">
                            <thead>
                                <tr>
                                    <th>Specialist</th>
                                    <th>Title</th>
                                    <th>Rating</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var prov in Model)
                                {
                                    <tr>
                                        <td>
                                            <div class="text-white fw-bold small">@prov.Name</div>
                                            <div class="text-muted small" style="font-size:0.75rem;">@prov.Email</div>
                                        </td>
                                        <td class="text-secondary small">@prov.Title</td>
                                        <td>
                                            <div class="text-warning small d-flex align-items-center gap-1">
                                                <i class="bi bi-star-fill"></i> @prov.Rating.ToString("0.0")
                                            </div>
                                        </td>
                                        <td>
                                            <form asp-action="DeleteProvider" method="post" onsubmit="return confirm('Are you sure you want to remove this specialist?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@prov.Id" />
                                                <button type="submit" class="btn btn-sm btn-custom btn-custom-danger py-1 px-2" style="font-size:0.75rem;" title="Remove Specialist">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Add New Specialist Card -->
            <div class="col-md-5">
                <div class="glass-panel">
                    <h5 class="text-white mb-4"><i class="bi bi-person-plus-fill text-primary me-2"></i> Register Specialist</h5>
                    
                    <form asp-action="AddProvider" method="post">
                        @Html.AntiForgeryToken()
                        
                        <div class="mb-3">
                            <label for="name" class="form-label text-white small">Full Name</label>
                            <input type="text" class="form-control form-control-custom" id="name" name="name" required placeholder="e.g. Dr. Emily Carter" />
                        </div>
                        
                        <div class="mb-3">
                            <label for="title" class="form-label text-white small">Professional Title</label>
                            <input type="text" class="form-control form-control-custom" id="title" name="title" required placeholder="e.g. Senior Pediatrician" />
                        </div>

                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <label for="email" class="form-label text-white small">Email</label>
                                <input type="email" class="form-control form-control-custom" id="email" name="email" placeholder="emily.c@bookingsystem.com" />
                            </div>
                            <div class="col-6">
                                <label for="phone" class="form-label text-white small">Phone</label>
                                <input type="tel" class="form-control form-control-custom" id="phone" name="phone" placeholder="+1 555-9090" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="rating" class="form-label text-white small">Initial Rating (1.0 to 5.0)</label>
                            <input type="number" step="0.1" class="form-control form-control-custom" id="rating" name="rating" placeholder="5.0" min="1" max="5" value="5.0" />
                        </div>

                        <div class="mb-4">
                            <label for="bio" class="form-label text-white small">Biography</label>
                            <textarea class="form-control form-control-custom" id="bio" name="bio" rows="3" placeholder="Summary of qualifications and specialties..."></textarea>
                        </div>

                        <button type="submit" class="btn btn-custom btn-custom-primary w-100 py-2">
                            <i class="bi bi-person-check-fill me-1"></i> Register Specialist
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
