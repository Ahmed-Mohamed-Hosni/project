@model Product
@{
    ViewData["Title"] = Model.Name;
    var relatedProducts = (List<Product>)ViewBag.RelatedProducts;
}

<div class="page-header">
    <div class="container">
        <h1>Product Details</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Shop">Shop</a></li>
                <li class="breadcrumb-item active">@Model.Name</li>
            </ol>
        </nav>
    </div>
</div>

<div class="product-detail-page">
    <div class="container">
        <div class="row g-4">
            <div class="col-lg-5">
                <div class="product-detail-img">
                    <img src="@(Model.ImageUrl ?? "/images/products/default.png")" alt="@Model.Name" />
                </div>
            </div>
            <div class="col-lg-7">
                <div class="product-detail-info">
                    <span class="product-category">@Model.Category?.Name</span>
                    <h1>@Model.Name</h1>
                    <div class="product-price">$@Model.Price.ToString("N2")</div>
                    <div class="product-description">@Model.Description</div>
                    <div class="stock-info">
                        <i class="fas fa-check-circle"></i>
                        @if (Model.StockQuantity > 0)
                        {
                            <span class="in-stock">In Stock (@Model.StockQuantity available)</span>
                        }
                        else
                        {
                            <span class="out-of-stock">Out of Stock</span>
                        }
                    </div>
                    @if (Model.StockQuantity > 0)
                    {
                        <a href="@Url.Action("AddToCart", "Cart", new { productId = Model.Id })" class="btn-add-to-cart-lg">
                            <i class="fas fa-shopping-cart"></i> Add to Cart
                        </a>
                    }
                    else
                    {
                        <button class="btn-add-to-cart-lg" disabled style="opacity:0.5;cursor:not-allowed;">
                            <i class="fas fa-times-circle"></i> Out of Stock
                        </button>
                    }
                </div>
            </div>
        </div>

        <!-- Related Products -->
        @if (relatedProducts.Any())
        {
            <div class="mt-5">
                <div class="section-title" style="text-align:left;">
                    <h2 style="font-size:1.5rem;">Related Products</h2>
                </div>
                <div class="row g-4">
                    @foreach (var product in relatedProducts)
                    {
                        <div class="col-lg-3 col-md-6">
                            <div class="product-card">
                                <div class="card-img-wrapper" style="height:180px;">
                                    <img src="@(product.ImageUrl ?? "/images/products/default.png")" alt="@product.Name" />
                                </div>
                                <div class="card-body">
                                    <a href="@Url.Action("Details", new { id = product.Id })" class="product-name">@product.Name</a>
                                    <div class="product-price" style="font-size:1.1rem;">$@product.Price.ToString("N2")</div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>
