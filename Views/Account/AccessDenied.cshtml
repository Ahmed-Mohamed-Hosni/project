@{
    ViewData["Title"] = "Access Denied";
}

<div class="confirmation-page">
    <div class="container">
        <div class="confirmation-icon" style="background:linear-gradient(135deg, #FF6584, #d63031);">
            <i class="fas fa-lock"></i>
        </div>
        <h2 style="font-weight:800;margin-bottom:10px;">Access Denied</h2>
        <p style="color:#636e72;font-size:1.1rem;margin-bottom:30px;">You don't have permission to access this page.</p>
        <a href="@Url.Action("Index", "Home")" class="btn-primary-custom">
            <i class="fas fa-home"></i> Go Home
        </a>
    </div>
</div>
