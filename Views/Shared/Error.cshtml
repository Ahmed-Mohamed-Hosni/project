@model E_Commerce.Models.ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="confirmation-page">
    <div class="container">
        <div class="confirmation-icon" style="background:linear-gradient(135deg, #FF6584, #d63031);">
            <i class="fas fa-exclamation-circle"></i>
        </div>
        <h2 style="font-weight:800;margin-bottom:10px;">Oops! Something went wrong</h2>
        <p style="color:#636e72;font-size:1.1rem;margin-bottom:30px;">An unexpected error occurred. Please try again later.</p>
        @if (Model?.ShowRequestId ?? false)
        {
            <p style="color:#b2bec3;font-size:0.85rem;">Request ID: <code>@Model?.RequestId</code></p>
        }
        <a href="@Url.Action("Index", "Home")" class="btn-primary-custom">
            <i class="fas fa-home"></i> Go Home
        </a>
    </div>
</div>
