@model IEnumerable<Product>
@{
    ViewData["Title"] = "Shop";
    var categories = (List<Category>)ViewBag.Categories;
    var currentCategory = (int?)ViewBag.CurrentCategory;
    var searchQuery = (string?)ViewBag.SearchQuery;
}

<div class="page-header">
    <div class="container">
        <h1>Shop</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="breadcrumb-item active">Shop</li>
            </ol>
        </nav>
    </div>
</div>

<div class="shop-page">
    <div class="container">
        <div class="row g-4">
            <!-- Sidebar -->
            <div class="col-lg-3">
                <div class="sidebar-filter">
                    <h5><i class="fas fa-filter"></i> Categories</h5>
                    <ul class="category-list">
                        <li>
                            <a href="@Url.Action("Shop", new { search = searchQuery })" class="@(currentCategory == null ? "active" : "")">
                                All Products <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill">@Model.Count()</span>
                            </a>
                        </li>
                        @foreach (var cat in categories)
                        {
                            <li>
                                <a href="@Url.Action("Shop", new { categoryId = cat.Id, search = searchQuery })" 
                                   class="@(currentCategory == cat.Id ? "active" : "")">
                                    @cat.Name <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill">@cat.Products.Count</span>
                                </a>
                            </li>
                        }
                    </ul>
                </div>

                <!-- Search Box -->
                <div class="sidebar-filter mt-3">
                    <h5><i class="fas fa-search"></i> Search</h5>
                    <form asp-action="Shop" method="get">
                        @if (currentCategory.HasValue)
                        {
                            <input type="hidden" name="categoryId" value="@currentCategory" />
                        }
                        <div class="input-group">
                            <input type="text" name="search" class="form-control" placeholder="Search products..." value="@searchQuery" style="border-radius:8px 0 0 8px;" />
                            <button type="submit" class="btn btn-primary" style="border-radius:0 8px 8px 0;background:#6C63FF;border:none;"><i class="fas fa-search"></i></button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Products Grid -->
            <div class="col-lg-9">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <p style="color:#636e72;margin:0;">Showing <strong>@Model.Count()</strong> products</p>
                    @if (!string.IsNullOrEmpty(searchQuery))
                    {
                        <span class="badge bg-primary bg-opacity-10 text-primary" style="font-size:0.85rem;padding:8px 16px;">
                            Search: "@searchQuery" <a href="@Url.Action("Shop", new { categoryId = currentCategory })" style="color:#d63031;margin-left:8px;"><i class="fas fa-times"></i></a>
                        </span>
                    }
                </div>

                @if (Model.Any())
                {
                    <div class="row g-4">
                        @foreach (var product in Model)
                        {
                            <div class="col-lg-4 col-md-6">
                                <div class="product-card">
                                    <div class="card-img-wrapper">
                                        <img src="@(product.ImageUrl ?? "/images/products/default.png")" alt="@product.Name" />
                                        @if (product.StockQuantity == 0)
                                        {
                                            <span class="badge-overlay" style="background:#d63031;">Sold Out</span>
                                        }
                                        <div class="quick-actions">
                                            <a href="@Url.Action("Details", "Home", new { id = product.Id })"><i class="fas fa-eye"></i></a>
                                            <a href="@Url.Action("AddToCart", "Cart", new { productId = product.Id })"><i class="fas fa-shopping-cart"></i></a>
                                        </div>
                                    </div>
                                    <div class="card-body">
                                        <span class="product-category">@product.Category?.Name</span>
                                        <a href="@Url.Action("Details", "Home", new { id = product.Id })" class="product-name">@product.Name</a>
                                        <div class="product-price">$@product.Price.ToString("N2")</div>
                                        <a href="@Url.Action("AddToCart", "Cart", new { productId = product.Id })" class="btn-add-cart">
                                            <i class="fas fa-shopping-cart"></i> Add to Cart
                                        </a>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="empty-state">
                        <i class="fas fa-search"></i>
                        <h3>No Products Found</h3>
                        <p>Try adjusting your search or filter to find what you're looking for.</p>
                        <a href="@Url.Action("Shop")" class="btn-primary-custom mt-3">Clear Filters</a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
