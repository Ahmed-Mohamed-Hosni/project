@model IEnumerable<ShoppingCartItem>
@{
    ViewData["Title"] = "Shopping Cart";
    var cartTotal = (decimal)ViewBag.CartTotal;
}

<div class="page-header">
    <div class="container">
        <h1><i class="fas fa-shopping-cart"></i> Shopping Cart</h1>
    </div>
</div>

<div class="cart-container">
    <div class="container">
        @if (Model.Any())
        {
            <div class="row g-4">
                <div class="col-lg-8">
                    <div class="cart-table">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Product</th>
                                    <th>Price</th>
                                    <th>Quantity</th>
                                    <th>Subtotal</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>
                                            <div class="product-info">
                                                <img src="@(item.Product?.ImageUrl ?? "/images/products/default.png")" alt="@item.Product?.Name" />
                                                <div>
                                                    <strong>@item.Product?.Name</strong>
                                                </div>
                                            </div>
                                        </td>
                                        <td>$@item.Product?.Price.ToString("N2")</td>
                                        <td>
                                            <div class="quantity-control">
                                                <a href="@Url.Action("DecreaseQuantity", "Cart", new { productId = item.ProductId })"><i class="fas fa-minus"></i></a>
                                                <span style="font-weight:600;min-width:24px;text-align:center;">@item.Quantity</span>
                                                <a href="@Url.Action("IncreaseQuantity", "Cart", new { productId = item.ProductId })"><i class="fas fa-plus"></i></a>
                                            </div>
                                        </td>
                                        <td><strong>$@((item.Product!.Price * item.Quantity).ToString("N2"))</strong></td>
                                        <td>
                                            <a href="@Url.Action("RemoveFromCart", "Cart", new { productId = item.ProductId })" class="text-danger" title="Remove"><i class="fas fa-trash"></i></a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="cart-summary">
                        <h4><i class="fas fa-receipt"></i> Order Summary</h4>
                        <div class="summary-row">
                            <span>Items (@Model.Sum(i => i.Quantity))</span>
                            <span>$@cartTotal.ToString("N2")</span>
                        </div>
                        <div class="summary-row">
                            <span>Shipping</span>
                            <span style="color:#00D9A6;font-weight:600;">@(cartTotal >= 50 ? "FREE" : "$5.00")</span>
                        </div>
                        <div class="summary-row summary-total">
                            <span>Total</span>
                            <span>$@((cartTotal >= 50 ? cartTotal : cartTotal + 5).ToString("N2"))</span>
                        </div>
                        <a href="@Url.Action("Checkout", "Order")" class="btn-checkout">
                            <i class="fas fa-lock"></i> Proceed to Checkout
                        </a>
                        <a href="@Url.Action("Shop", "Home")" class="btn btn-outline-secondary w-100 mt-2" style="border-radius:25px;">
                            <i class="fas fa-arrow-left"></i> Continue Shopping
                        </a>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="empty-state">
                <i class="fas fa-shopping-cart"></i>
                <h3>Your Cart is Empty</h3>
                <p>Looks like you haven't added any items to your cart yet.</p>
                <a href="@Url.Action("Shop", "Home")" class="btn-primary-custom mt-3">
                    <i class="fas fa-store"></i> Start Shopping
                </a>
            </div>
        }
    </div>
</div>
