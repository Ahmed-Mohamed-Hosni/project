@model Order
@{
    ViewData["Title"] = "Order #" + Model.Id;
}

<div class="page-header">
    <div class="container">
        <h1>Order #@Model.Id</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="MyOrders">My Orders</a></li>
                <li class="breadcrumb-item active">Order #@Model.Id</li>
            </ol>
        </nav>
    </div>
</div>

<div style="padding:40px 0;">
    <div class="container">
        <div class="row g-4">
            <div class="col-lg-8">
                <div style="background:#fff;border-radius:12px;padding:30px;box-shadow:0 2px 8px rgba(0,0,0,0.05);">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 style="font-weight:700;margin:0;">Order Items</h5>
                        @{
                            var badgeClass = Model.OrderStatus switch
                            {
                                "Pending" => "badge-pending",
                                "Processing" => "badge-processing",
                                "Shipped" => "badge-shipped",
                                "Delivered" => "badge-delivered",
                                "Cancelled" => "badge-cancelled",
                                _ => "badge-pending"
                            };
                        }
                        <span class="badge-status @badgeClass" style="padding:6px 14px;border-radius:20px;font-weight:600;">@Model.OrderStatus</span>
                    </div>
                    <hr />
                    @foreach (var item in Model.OrderDetails)
                    {
                        <div style="display:flex;align-items:center;gap:15px;padding:12px 0;border-bottom:1px solid #eef0f5;">
                            <img src="@(item.Product?.ImageUrl ?? "/images/products/default.png")" 
                                 style="width:55px;height:55px;object-fit:contain;border-radius:8px;background:#f8f9fd;padding:4px;" />
                            <div style="flex:1;">
                                <strong>@item.Product?.Name</strong>
                                <div style="color:#636e72;font-size:0.85rem;">Qty: @item.Count × $@item.Price.ToString("N2")</div>
                            </div>
                            <strong style="color:#6C63FF;">$@((item.Price * item.Count).ToString("N2"))</strong>
                        </div>
                    }
                    <div style="display:flex;justify-content:space-between;padding-top:16px;font-size:1.2rem;font-weight:800;">
                        <span>Total</span>
                        <span style="color:#6C63FF;">$@Model.OrderTotal.ToString("N2")</span>
                    </div>
                </div>
            </div>
            <div class="col-lg-4">
                <div style="background:#fff;border-radius:12px;padding:30px;box-shadow:0 2px 8px rgba(0,0,0,0.05);">
                    <h5 style="font-weight:700;margin-bottom:16px;"><i class="fas fa-truck" style="color:#FF6584;"></i> Shipping</h5>
                    <p style="margin-bottom:6px;"><strong>@Model.Name</strong></p>
                    <p style="margin-bottom:6px;color:#636e72;">@Model.Address</p>
                    <p style="margin-bottom:6px;color:#636e72;">@Model.City</p>
                    <p style="color:#636e72;"><i class="fas fa-phone"></i> @Model.PhoneNumber</p>
                    <hr />
                    <p style="color:#636e72;font-size:0.85rem;"><i class="fas fa-calendar"></i> @Model.OrderDate.ToString("MMMM dd, yyyy HH:mm")</p>
                </div>
            </div>
        </div>
        <a href="@Url.Action("MyOrders")" class="btn btn-outline-secondary mt-3" style="border-radius:25px;"><i class="fas fa-arrow-left"></i> Back to My Orders</a>
    </div>
</div>
