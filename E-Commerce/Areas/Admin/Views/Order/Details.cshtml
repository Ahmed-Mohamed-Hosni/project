@model E_Commerce.Models.Order
@{
    ViewData["Title"] = "Order #" + Model.Id;
}

<div class="row g-4">
    <div class="col-lg-8">
        <div class="admin-form-card mb-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 style="font-weight:700;margin:0;">Order #@Model.Id</h5>
                @{
                    var badgeClass = Model.OrderStatus switch
                    {
                        "Pending" => "badge-pending",
                        "Processing" => "badge-processing",
                        "Shipped" => "badge-shipped",
                        "Delivered" => "badge-delivered",
                        "Cancelled" => "badge-cancelled",
                        _ => "badge-pending"
                    };
                }
                <span class="badge-status @badgeClass" style="font-size:0.9rem;">@Model.OrderStatus</span>
            </div>
            <hr />
            <table class="table">
                <thead>
                    <tr>
                        <th style="background:transparent;color:#636e72;border-bottom:2px solid #eef0f5;">Product</th>
                        <th style="background:transparent;color:#636e72;border-bottom:2px solid #eef0f5;">Price</th>
                        <th style="background:transparent;color:#636e72;border-bottom:2px solid #eef0f5;">Qty</th>
                        <th style="background:transparent;color:#636e72;border-bottom:2px solid #eef0f5;">Subtotal</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.OrderDetails)
                    {
                        <tr>
                            <td>
                                <div style="display:flex;align-items:center;gap:12px;">
                                    <img src="@(item.Product?.ImageUrl ?? "/images/products/default.png")" style="width:45px;height:45px;object-fit:contain;border-radius:8px;background:#f8f9fd;padding:3px;" />
                                    <strong>@item.Product?.Name</strong>
                                </div>
                            </td>
                            <td>$@item.Price.ToString("N2")</td>
                            <td>@item.Count</td>
                            <td><strong>$@((item.Price * item.Count).ToString("N2"))</strong></td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="3" style="text-align:right;font-weight:700;font-size:1.1rem;">Total:</td>
                        <td style="font-weight:800;font-size:1.2rem;color:#6C63FF;">$@Model.OrderTotal.ToString("N2")</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
    <div class="col-lg-4">
        <!-- Customer Info -->
        <div class="admin-form-card mb-4">
            <h6 style="font-weight:700;margin-bottom:16px;"><i class="fas fa-user" style="color:#6C63FF;"></i> Customer Info</h6>
            <p style="margin-bottom:6px;"><strong>@Model.User?.FullName</strong></p>
            <p style="margin-bottom:6px;color:#636e72;">@Model.User?.Email</p>
        </div>

        <!-- Shipping Info -->
        <div class="admin-form-card mb-4">
            <h6 style="font-weight:700;margin-bottom:16px;"><i class="fas fa-truck" style="color:#FF6584;"></i> Shipping Info</h6>
            <p style="margin-bottom:6px;"><strong>@Model.Name</strong></p>
            <p style="margin-bottom:6px;color:#636e72;">@Model.Address</p>
            <p style="margin-bottom:6px;color:#636e72;">@Model.City</p>
            <p style="margin-bottom:6px;color:#636e72;"><i class="fas fa-phone"></i> @Model.PhoneNumber</p>
            <p style="color:#636e72;"><i class="fas fa-calendar"></i> @Model.OrderDate.ToString("MMMM dd, yyyy HH:mm")</p>
        </div>

        <!-- Update Status -->
        <div class="admin-form-card">
            <h6 style="font-weight:700;margin-bottom:16px;"><i class="fas fa-sync" style="color:#00D9A6;"></i> Update Status</h6>
            <form asp-action="UpdateStatus" method="post">
                <input type="hidden" name="id" value="@Model.Id" />
                <select name="status" class="form-control mb-3">
                    <option value="Pending" selected="@(Model.OrderStatus == "Pending")">Pending</option>
                    <option value="Processing" selected="@(Model.OrderStatus == "Processing")">Processing</option>
                    <option value="Shipped" selected="@(Model.OrderStatus == "Shipped")">Shipped</option>
                    <option value="Delivered" selected="@(Model.OrderStatus == "Delivered")">Delivered</option>
                    <option value="Cancelled" selected="@(Model.OrderStatus == "Cancelled")">Cancelled</option>
                </select>
                <button type="submit" class="btn btn-admin-primary w-100"><i class="fas fa-check"></i> Update Status</button>
            </form>
        </div>
    </div>
</div>

<a href="@Url.Action("Index")" class="btn btn-outline-secondary mt-3"><i class="fas fa-arrow-left"></i> Back to Orders</a>
