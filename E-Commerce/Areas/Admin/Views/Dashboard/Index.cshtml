@{
    ViewData["Title"] = "Dashboard";
}

<div class="row g-4 mb-4">
    <div class="col-lg-3 col-md-6">
        <div class="stat-card">
            <div class="stat-icon icon-purple"><i class="fas fa-box"></i></div>
            <h3>@ViewBag.TotalProducts</h3>
            <p>Total Products</p>
        </div>
    </div>
    <div class="col-lg-3 col-md-6">
        <div class="stat-card">
            <div class="stat-icon icon-pink"><i class="fas fa-shopping-bag"></i></div>
            <h3>@ViewBag.TotalOrders</h3>
            <p>Total Orders</p>
        </div>
    </div>
    <div class="col-lg-3 col-md-6">
        <div class="stat-card">
            <div class="stat-icon icon-green"><i class="fas fa-dollar-sign"></i></div>
            <h3>$@ViewBag.TotalRevenue.ToString("N2")</h3>
            <p>Total Revenue</p>
        </div>
    </div>
    <div class="col-lg-3 col-md-6">
        <div class="stat-card">
            <div class="stat-icon icon-blue"><i class="fas fa-clock"></i></div>
            <h3>@ViewBag.PendingOrders</h3>
            <p>Pending Orders</p>
        </div>
    </div>
</div>

<!-- Quick Actions -->
<div class="row g-4 mb-4">
    <div class="col-md-6">
        <div class="stat-card">
            <h5 style="font-weight:700;margin-bottom:16px;"><i class="fas fa-plus-circle" style="color:#6C63FF;"></i> Quick Actions</h5>
            <div class="d-flex gap-2 flex-wrap">
                <a href="@Url.Action("Create", "Product", new { area = "Admin" })" class="btn btn-admin-primary btn-sm"><i class="fas fa-plus"></i> New Product</a>
                <a href="@Url.Action("Create", "Category", new { area = "Admin" })" class="btn btn-admin-primary btn-sm"><i class="fas fa-plus"></i> New Category</a>
                <a href="@Url.Action("Index", "Order", new { area = "Admin", status = "Pending" })" class="btn btn-outline-warning btn-sm"><i class="fas fa-clock"></i> Pending Orders</a>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="stat-card">
            <h5 style="font-weight:700;margin-bottom:16px;"><i class="fas fa-tags" style="color:#FF6584;"></i> Categories</h5>
            <p style="font-size:2rem;font-weight:800;color:#2d3436;margin:0;">@ViewBag.TotalCategories</p>
            <p style="color:#636e72;font-size:0.85rem;">Active categories in store</p>
        </div>
    </div>
</div>

<!-- Recent Orders -->
<div class="admin-table">
    <div style="padding:20px 18px 10px;display:flex;justify-content:space-between;align-items:center;">
        <h5 style="font-weight:700;margin:0;">Recent Orders</h5>
        <a href="@Url.Action("Index", "Order", new { area = "Admin" })" style="color:#6C63FF;font-weight:600;font-size:0.85rem;text-decoration:none;">View All <i class="fas fa-arrow-right"></i></a>
    </div>
    <table class="table">
        <thead>
            <tr>
                <th>Order #</th>
                <th>Customer</th>
                <th>Date</th>
                <th>Total</th>
                <th>Status</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @if (ViewBag.RecentOrders != null)
            {
                foreach (var order in (List<E_Commerce.Models.Order>)ViewBag.RecentOrders)
                {
                    var badgeClass = order.OrderStatus switch
                    {
                        "Pending" => "badge-pending",
                        "Processing" => "badge-processing",
                        "Shipped" => "badge-shipped",
                        "Delivered" => "badge-delivered",
                        "Cancelled" => "badge-cancelled",
                        _ => "badge-pending"
                    };
                    <tr>
                        <td><strong>#@order.Id</strong></td>
                        <td>@order.User?.FullName</td>
                        <td>@order.OrderDate.ToString("MMM dd, yyyy")</td>
                        <td><strong>$@order.OrderTotal.ToString("N2")</strong></td>
                        <td><span class="badge-status @badgeClass">@order.OrderStatus</span></td>
                        <td><a href="@Url.Action("Details", "Order", new { area = "Admin", id = order.Id })" class="btn btn-sm btn-outline-primary">Details</a></td>
                    </tr>
                }
            }
        </tbody>
    </table>
    @if (ViewBag.RecentOrders == null || ((List<E_Commerce.Models.Order>)ViewBag.RecentOrders).Count == 0)
    {
        <div style="text-align:center;padding:40px;color:#636e72;">
            <i class="fas fa-inbox" style="font-size:2rem;margin-bottom:10px;display:block;"></i>
            <p>No orders yet</p>
        </div>
    }
</div>
