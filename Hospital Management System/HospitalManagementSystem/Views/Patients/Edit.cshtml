@model HospitalManagementSystem.Models.Patient
@{
    ViewData["Title"] = "Edit Patient Record";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="premium-card p-5">
            <div class="mb-4">
                <a asp-action="Index" class="btn btn-outline-glass btn-sm mb-3"><i class="fa-solid fa-arrow-left me-1"></i> Back to Directory</a>
                <h4 class="font-weight-bold text-primary"><i class="fa-solid fa-user-pen me-2"></i> Edit Patient Demographics</h4>
                <p class="text-muted">Modify registration details or medical profile logs for the patient record file.</p>
            </div>

            <form asp-action="Edit" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="CreatedAt" />

                <div class="row g-3">
                    <!-- Name -->
                    <div class="col-md-6">
                        <label asp-for="Name" class="form-label form-label-custom">Full Name</label>
                        <input asp-for="Name" class="form-control form-glass" required />
                        <span asp-validation-for="Name" class="text-danger text-xs"></span>
                    </div>

                    <!-- Email -->
                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label form-label-custom">Email Address</label>
                        <input asp-for="Email" type="email" class="form-control form-glass" required />
                        <span asp-validation-for="Email" class="text-danger text-xs"></span>
                    </div>

                    <!-- Phone -->
                    <div class="col-md-6">
                        <label asp-for="Phone" class="form-label form-label-custom">Phone Number</label>
                        <input asp-for="Phone" class="form-control form-glass" required />
                        <span asp-validation-for="Phone" class="text-danger text-xs"></span>
                    </div>

                    <!-- Gender -->
                    <div class="col-md-3">
                        <label asp-for="Gender" class="form-label form-label-custom">Gender</label>
                        <select asp-for="Gender" class="form-select form-glass" required>
                            <option value="Male">Male</option>
                            <option value="Female">Female</option>
                            <option value="Other">Other</option>
                        </select>
                        <span asp-validation-for="Gender" class="text-danger text-xs"></span>
                    </div>

                    <!-- Date Of Birth -->
                    <div class="col-md-3">
                        <label asp-for="DateOfBirth" class="form-label form-label-custom">Date of Birth</label>
                        <input asp-for="DateOfBirth" type="date" class="form-control form-glass" required />
                        <span asp-validation-for="DateOfBirth" class="text-danger text-xs"></span>
                    </div>

                    <!-- Address -->
                    <div class="col-12">
                        <label asp-for="Address" class="form-label form-label-custom">Residential Address</label>
                        <input asp-for="Address" class="form-control form-glass" required />
                        <span asp-validation-for="Address" class="text-danger text-xs"></span>
                    </div>

                    <!-- Medical History -->
                    <div class="col-12">
                        <label asp-for="MedicalHistory" class="form-label form-label-custom">Chronic Conditions & Medical History</label>
                        <textarea asp-for="MedicalHistory" class="form-control form-glass" rows="4"></textarea>
                        <span asp-validation-for="MedicalHistory" class="text-danger text-xs"></span>
                    </div>

                    <!-- Buttons -->
                    <div class="col-12 text-end mt-4">
                        <a asp-action="Index" class="btn btn-outline-glass me-2">Cancel</a>
                        <button type="submit" class="btn-grad"><i class="fa-solid fa-save me-1"></i> Save Changes</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
