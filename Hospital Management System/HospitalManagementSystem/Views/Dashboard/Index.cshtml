@model IEnumerable<HospitalManagementSystem.Models.Appointment>
@{
    ViewData["Title"] = "Dashboard";
}

<!-- Welcome Header Section -->
<div class="premium-card p-4 mb-4" style="background: linear-gradient(135deg, rgba(2, 132, 199, 0.05) 0%, rgba(13, 148, 136, 0.05) 100%); border-left: 4px solid var(--color-primary);">
    <div class="row align-items-center">
        <div class="col-md-8">
            <h4 class="mb-1 text-primary fw-bold">Clinical Administration Portal</h4>
            <p class="text-muted mb-0">Monitor patient activities, manage appointments, and check reports. Architected & Coded by <strong>Ahmed Mohamed Hosni</strong>.</p>
        </div>
        <div class="col-md-4 text-md-end mt-3 mt-md-0">
            <span class="badge badge-custom badge-approved"><i class="fa-solid fa-circle-check"></i> System Active</span>
            <span class="badge badge-custom badge-completed ms-2"><i class="fa-solid fa-server"></i> SQL Database Online</span>
        </div>
    </div>
</div>

<!-- Metrics Cards Grid -->
<div class="metrics-grid">
    <div class="premium-card metric-card card-primary hover-scale">
        <div class="metric-header">
            <span class="metric-title">Total Patients</span>
            <div class="metric-icon"><i class="fa-solid fa-user-injured"></i></div>
        </div>
        <div class="metric-value">@ViewBag.TotalPatients</div>
        <div class="metric-footer">Registered in registry</div>
    </div>

    <div class="premium-card metric-card card-teal hover-scale">
        <div class="metric-header">
            <span class="metric-title">Today's Appointments</span>
            <div class="metric-icon"><i class="fa-solid fa-calendar-check"></i></div>
        </div>
        <div class="metric-value">@ViewBag.TodayAppointmentsCount</div>
        <div class="metric-footer">Scheduled for today</div>
    </div>

    <div class="premium-card metric-card card-purple hover-scale">
        <div class="metric-header">
            <span class="metric-title">Active Doctors</span>
            <div class="metric-icon"><i class="fa-solid fa-user-doctor"></i></div>
        </div>
        <div class="metric-value">@ViewBag.TotalDoctors</div>
        <div class="metric-footer">Medical staff members</div>
    </div>

    <div class="premium-card metric-card card-pink hover-scale">
        <div class="metric-header">
            <span class="metric-title">Unpaid Receivables</span>
            <div class="metric-icon"><i class="fa-solid fa-receipt"></i></div>
        </div>
        <div class="metric-value">$@ViewBag.PendingBillsTotal.ToString("N2")</div>
        <div class="metric-footer"><span>@ViewBag.PendingBillsCount</span> outstanding bills</div>
    </div>
</div>

<div class="row">
    <!-- Upcoming Appointments Table -->
    <div class="col-xl-8 mb-4">
        <div class="premium-card h-100 p-4">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h5 class="card-section-title mb-0"><i class="fa-solid fa-calendar-check"></i> Upcoming Clinical Schedule</h5>
                <a asp-controller="Appointments" asp-action="Create" class="btn-grad btn-sm"><i class="fa-solid fa-plus"></i> Book Appointment</a>
            </div>
            
            <div class="table-responsive">
                <table class="custom-table">
                    <thead>
                        <tr>
                            <th>Patient</th>
                            <th>Consulting Doctor</th>
                            <th>Schedule Date / Time</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var app in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-bold">@app.Patient?.Name</div>
                                        <div class="text-xs text-muted">Phone: @app.Patient?.Phone</div>
                                    </td>
                                    <td>
                                        <div class="fw-bold text-slate">@app.Doctor?.Name</div>
                                        <span class="text-xs text-muted">@app.Doctor?.Specialization</span>
                                    </td>
                                    <td>
                                        <div>@app.AppointmentDate.ToString("MMMM dd, yyyy")</div>
                                        <div class="text-xs text-primary fw-bold"><i class="fa-regular fa-clock me-1"></i>@app.TimeSlot.ToString(@"hh\:mm")</div>
                                    </td>
                                    <td>
                                        @if (app.Status == "Pending")
                                        {
                                            <span class="badge-custom badge-pending">@app.Status</span>
                                        }
                                        else if (app.Status == "Approved")
                                        {
                                            <span class="badge-custom badge-approved">@app.Status</span>
                                        }
                                        else if (app.Status == "Completed")
                                        {
                                            <span class="badge-custom badge-completed">@app.Status</span>
                                        }
                                        else
                                        {
                                            <span class="badge-custom badge-cancelled">@app.Status</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="d-flex gap-2">
                                            @if (app.Status == "Pending")
                                            {
                                                <form asp-controller="Appointments" asp-action="Approve" asp-route-id="@app.Id" method="post" class="d-inline">
                                                    <button type="submit" class="btn btn-outline-glass btn-sm py-1 px-2" title="Approve"><i class="fa-solid fa-check text-emerald"></i></button>
                                                </form>
                                            }
                                            @if (app.Status == "Approved" || app.Status == "Pending")
                                            {
                                                <form asp-controller="Appointments" asp-action="Complete" asp-route-id="@app.Id" method="post" class="d-inline">
                                                    <button type="submit" class="btn btn-outline-glass btn-sm py-1 px-2" title="Mark Complete"><i class="fa-solid fa-circle-check text-primary"></i></button>
                                                </form>
                                                <form asp-controller="Appointments" asp-action="Cancel" asp-route-id="@app.Id" method="post" class="d-inline">
                                                    <button type="submit" class="btn btn-outline-glass btn-sm py-1 px-2" title="Cancel"><i class="fa-solid fa-times text-danger"></i></button>
                                                </form>
                                            }
                                            <a asp-controller="Patients" asp-action="Details" asp-route-id="@app.PatientId" class="btn btn-outline-glass btn-sm py-1 px-2" title="View Profile"><i class="fa-solid fa-arrow-right-to-bracket text-teal"></i></a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5 text-muted">No upcoming appointments found.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Appointment Status Breakdown Chart -->
    <div class="col-xl-4 mb-4">
        <div class="premium-card p-4 h-100">
            <h5 class="card-section-title mb-4"><i class="fa-solid fa-chart-pie"></i> Appointment Distribution</h5>
            <div class="chart-container d-flex align-items-center justify-content-center">
                <canvas id="statusChart" style="max-height: 230px; max-width: 230px;"></canvas>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const ctx = document.getElementById('statusChart').getContext('2d');
            
            const getColors = () => {
                const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
                return {
                    text: isDark ? '#f8fafc' : '#0f172a',
                    border: isDark ? '#1e293b' : '#ffffff'
                };
            };
            
            let configColors = getColors();
            
            const myChart = new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: @Html.Raw(Json.Serialize(ViewBag.StatusLabels)),
                    datasets: [{
                        data: @Html.Raw(Json.Serialize(ViewBag.StatusValues)),
                        backgroundColor: [
                            '#d97706', // Pending
                            '#0284c7', // Approved
                            '#16a34a', // Completed
                            '#dc2626'  // Cancelled
                        ],
                        borderWidth: 2,
                        borderColor: configColors.border
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: {
                                color: configColors.text,
                                font: {
                                    family: 'Plus Jakarta Sans',
                                    size: 11,
                                    weight: 600
                                },
                                padding: 12
                            }
                        }
                    },
                    cutout: '70%'
                }
            });
            
            // Listen for theme change events to update colors
            window.addEventListener('theme-changed', function() {
                const newColors = getColors();
                myChart.options.plugins.legend.labels.color = newColors.text;
                myChart.data.datasets[0].borderColor = newColors.border;
                myChart.update();
            });
        });
    </script>
}
