@model IEnumerable<TaskManagementSystem.Models.Board>
@{
    ViewData["Title"] = "My Boards";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
        <h2 class="fw-bold m-0"><i class="bi bi-person-workspace text-primary"></i> My Workspace</h2>
        <button class="btn btn-primary-custom" data-bs-toggle="modal" data-bs-target="#createBoardModal">
            <i class="bi bi-plus-lg"></i> Create New Board
        </button>
    </div>

    <div class="row g-4">
        @foreach (var board in Model)
        {
            <div class="col-md-4 col-sm-6">
                <a href="@Url.Action("Details", "Board", new { id = board.Id })" class="text-decoration-none text-dark">
                    <div class="card h-100 shadow-sm border-0 task-card" style="border-left: 4px solid var(--primary) !important;">
                        <div class="card-body">
                            <h5 class="fw-bold mb-2">@board.Title</h5>
                            <p class="text-muted small mb-0"><i class="bi bi-calendar3"></i> Created @board.CreatedAt.ToString("MMM dd, yyyy")</p>
                        </div>
                    </div>
                </a>
            </div>
        }
        @if(!Model.Any())
        {
            <div class="col-12 text-center py-5 bg-white shadow-sm rounded-3">
                <div class="mb-3">
                    <i class="bi bi-kanban text-muted" style="font-size: 3rem;"></i>
                </div>
                <h4 class="text-dark fw-bold">No boards yet</h4>
                <p class="text-muted">Create your first board to start managing tasks and collaborating with your team.</p>
                <button class="btn btn-primary-custom mt-2" data-bs-toggle="modal" data-bs-target="#createBoardModal">
                    Create Board
                </button>
            </div>
        }
    </div>
</div>

<!-- Create Board Modal -->
<div class="modal fade" id="createBoardModal" tabindex="-1" aria-labelledby="createBoardModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow">
      <div class="modal-header bg-light">
        <h5 class="modal-title fw-bold" id="createBoardModalLabel">Create New Board</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form asp-action="Create" asp-controller="Board" method="post">
          <div class="modal-body p-4">
            <div class="mb-3">
                <label for="boardTitle" class="form-label fw-semibold">Board Title</label>
                <input type="text" class="form-control form-control-lg bg-light" id="boardTitle" name="title" required placeholder="e.g. Website Redesign">
            </div>
          </div>
          <div class="modal-footer bg-light">
            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-primary-custom">Create</button>
          </div>
      </form>
    </div>
  </div>
</div>
